{
  "functions": {
    "api/runpod-bootstrap.ts": {
      "maxDuration": 60
    },
    "api/runpod-wake.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/tiktok/callback",
      "destination": "/api/studio?r=tiktok-callback"
    },
    {
      "source": "/api/tiktok/media/:file",
      "destination": "/api/studio?r=tiktok-media&f=:file"
    }
  ]
}
