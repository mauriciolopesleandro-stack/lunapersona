# Copie este arquivo para ".env" e preencha com valores reais.
# Nunca commitar o ".env" real.

# --- ComfyUI (RunPod) ---
# ATENCAO: o Pod ID muda sempre que a RunPod migra o pod para outro host
# (ja aconteceu 2x: sp8bay1sk6qs2o -> 4uisgq0k317va6 -> h7dsgu25e43vo1).
# Confirme o ID atual em https://console.runpod.io/pods antes de rodar.
# Use sempre a URL publica do proxy (nao 127.0.0.1), mesmo rodando o backend
# dentro do proprio pod: o backend usa essa URL tambem para montar os links
# de imagem devolvidos ao frontend, que roda no navegador do usuario.
COMFYUI_URL=https://h7dsgu25e43vo1-8188.proxy.runpod.net
RUNPOD_POD_ID=h7dsgu25e43vo1
COMFYUI_API_KEY=

# Chave de API da conta RunPod (console.runpod.io/user/settings > API Keys).
# So e usada pelo proprio backend para SE desligar via API da RunPod apos
# ficar N minutos sem receber geracoes (ver IDLE_SHUTDOWN_MINUTES abaixo).
# Preencher direto no .env do pod - nunca commitar.
RUNPOD_API_KEY=

# Minutos sem nenhuma chamada a /api/generate antes do backend desligar o
# proprio pod automaticamente. 0 desativa o auto-desligamento.
IDLE_SHUTDOWN_MINUTES=5

# --- SSH (auto-bootstrap do pod ao acordar) ---
# So usadas pela funcao serverless /api/runpod-bootstrap (roda na Vercel,
# nunca no pod). Deixam o frontend rodar "git pull + runpod_bootstrap.sh"
# sozinho assim que o pod fica "running", sem precisar abrir o Jupyter.
# A chave e gerada uma vez em scripts/generate_runpod_ssh_key.sh (fica fora
# do Git, em .secrets/) - cole a saida em BASE64 que o script imprime aqui/na
# Vercel, nunca a comite. Tem que ser base64 (nao o conteudo cru do arquivo):
# campos de env var de UI costumam perder as quebras de linha do formato
# OpenSSH ao colar, e isso quebra o parser ("Malformed OpenSSH private key").
# A chave publica correspondente vai na env var PUBLIC_KEY do proprio pod
# (RunPod > Edit Pod > Environment variables) - essa sim nao e segredo.
RUNPOD_SSH_PRIVATE_KEY=
RUNPOD_SSH_USER=root

# --- LLM (chat de apoio a criacao de prompts) ---
# Aponta para o Ollama rodando no MESMO pod do backend (por isso 127.0.0.1,
# diferente do COMFYUI_URL que usa a URL publica do proxy). Se o Ollama
# ainda nao estiver instalado no pod, o /api/chat responde 503.
LLM_API_URL=http://127.0.0.1:11434
LLM_API_KEY=
# Nome do modelo EXATAMENTE como aparece em "ollama list" no pod (ex:
# llama3.1:8b). Vazio = usa o primeiro modelo instalado no Ollama.
# O frontend nunca sabe o nome do modelo - so o backend.
LLM_MODEL=
# Segundos esperando a resposta do Ollama (a 1a mensagem inclui carregar o
# modelo na memoria, que pode demorar em modelos maiores).
LLM_TIMEOUT=300

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Timeouts / comportamento (segundos) ---
COMFYUI_CONNECT_TIMEOUT=10
COMFYUI_GENERATION_TIMEOUT=300
