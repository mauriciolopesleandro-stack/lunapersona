{
  "meta": {
    "id": "chroma-face-refine",
    "title": "Chroma1-HD - Correcao de rosto da persona",
    "description": "Passo depois da geracao com LoRA: o Florence-2 acha o rosto (FACE_TARGET) na imagem ja gerada (IMAGE, 'nome [output]'), o recorte e ampliado para FACE_RES, redesenhado com a LoRA (FACE_DENOISE) e colado de volta com borda suave (KJNodes ImageCropByMaskAndResize/ImageUncropByMask). Deixa o rosto nitido e fiel a persona mesmo pequeno, de longe ou vindo de foto de referencia.",
    "compatible_models": ["chroma1-hd-fp8"],
    "hidden": true,
    "required_params": ["IMAGE", "FACE_PROMPT", "LORA_NAME"],
    "optional_params": {
      "NEGATIVE_PROMPT": "low quality, blurry, deformed face, asymmetric eyes, bad teeth, plastic skin, airbrushed, cgi, 3d render, text, watermark",
      "FACE_TARGET": "woman's face",
      "FACE_RES": 1024,
      "FACE_DENOISE": 0.45,
      "FACE_STEPS": 20,
      "GUIDANCE": 3.0,
      "SEED": 0,
      "SAMPLER_NAME": "euler",
      "FILENAME_PREFIX": "luna_studio",
      "LORA_STRENGTH": 1.0
    }
  },
  "graph": {
    "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "${UNET_NAME}", "weight_dtype": "${UNET_WEIGHT_DTYPE}"}},
    "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "${CLIP_NAME_1}", "type": "${CLIP_TYPE}", "device": "default"}},
    "3": {"class_type": "VAELoader", "inputs": {"vae_name": "${VAE_NAME}"}},
    "4": {"class_type": "T5TokenizerOptions", "inputs": {"clip": ["2", 0], "min_padding": 0, "min_length": 0}},
    "5": {"class_type": "CLIPTextEncode", "inputs": {"text": "${FACE_PROMPT}", "clip": ["4", 0]}},
    "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "${NEGATIVE_PROMPT}", "clip": ["4", 0]}},
    "16": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["1", 0], "lora_name": "${LORA_NAME}", "strength_model": "${LORA_STRENGTH}"}},
    "7": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["16", 0], "shift": 1.0}},
    "8": {"class_type": "CFGGuider", "inputs": {"model": ["7", 0], "positive": ["5", 0], "negative": ["6", 0], "cfg": "${GUIDANCE}"}},
    "10": {"class_type": "RandomNoise", "inputs": {"noise_seed": "${SEED}"}},
    "11": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "${SAMPLER_NAME}"}},
    "12": {"class_type": "BetaSamplingScheduler", "inputs": {"model": ["7", 0], "steps": "${FACE_STEPS}", "alpha": 0.45, "beta": 0.45}},
    "13": {"class_type": "SplitSigmasDenoise", "inputs": {"sigmas": ["12", 0], "denoise": "${FACE_DENOISE}"}},
    "20": {"class_type": "LoadImage", "inputs": {"image": "${IMAGE}"}},
    "21": {"class_type": "DownloadAndLoadFlorence2Model", "inputs": {"model": "microsoft/Florence-2-large", "precision": "fp16"}},
    "22": {
      "class_type": "Florence2Run",
      "inputs": {
        "image": ["20", 0], "florence2_model": ["21", 0], "text_input": "${FACE_TARGET}",
        "task": "caption_to_phrase_grounding", "fill_mask": true, "keep_model_loaded": false,
        "max_new_tokens": 256, "num_beams": 3, "do_sample": false, "output_mask_select": "", "seed": 1
      }
    },
    "23": {"class_type": "GrowMask", "inputs": {"mask": ["22", 1], "expand": 12, "tapered_corners": true}},
    "24": {
      "class_type": "ImageCropByMaskAndResize",
      "inputs": {
        "image": ["20", 0], "mask": ["23", 0], "base_resolution": "${FACE_RES}", "padding": 96,
        "min_crop_resolution": 128, "max_crop_resolution": 2048
      }
    },
    "25": {"class_type": "VAEEncode", "inputs": {"pixels": ["24", 0], "vae": ["3", 0]}},
    "26": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {"noise": ["10", 0], "guider": ["8", 0], "sampler": ["11", 0], "sigmas": ["13", 1], "latent_image": ["25", 0]}
    },
    "27": {"class_type": "VAEDecode", "inputs": {"samples": ["26", 0], "vae": ["3", 0]}},
    "28": {"class_type": "ImageUncropByMask", "inputs": {"destination": ["20", 0], "source": ["27", 0], "mask": ["24", 1], "bbox": ["24", 2]}},
    "15": {"class_type": "SaveImage", "inputs": {"images": ["28", 0], "filename_prefix": "${FILENAME_PREFIX}"}}
  }
}
