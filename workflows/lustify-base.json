{
  "meta": {
    "id": "lustify-base",
    "title": "V2 - Lustify ZENITH V9 + LoRA SDXL da Luna (base)",
    "description": "Persona Engine V2 (experimental): geracao BASE em SDXL com a LoRA SDXL da Luna (lunavox_sdxl_v1, so UNet: LoraLoaderModelOnly). CFG > 1: o negativo E aplicado. Sem Qwen, sem pos-processamento. Os valores efetivos vem de config/persona_engine_v2.json.",
    "compatible_models": [],
    "hidden": true,
    "required_params": [
      "PROMPT",
      "NEGATIVE",
      "WIDTH",
      "HEIGHT",
      "SEED",
      "LORA_NAME"
    ],
    "optional_params": {
      "CKPT": "lustifyNSFWCheckpoint_zenithV9.safetensors",
      "LORA_STRENGTH": 1.0,
      "STEPS": 30,
      "CFG": 5.0,
      "SAMPLER": "dpmpp_2m_sde",
      "SCHEDULER": "karras",
      "FILENAME_PREFIX": "luna_v2_lustify"
    }
  },
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "${CKPT}"
      }
    },
    "2": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "lora_name": "${LORA_NAME}",
        "strength_model": "${LORA_STRENGTH}"
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "1",
          1
        ],
        "text": "${PROMPT}"
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "1",
          1
        ],
        "text": "${NEGATIVE}"
      }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": "${WIDTH}",
        "height": "${HEIGHT}",
        "batch_size": 1
      }
    },
    "6": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "positive": [
          "3",
          0
        ],
        "negative": [
          "4",
          0
        ],
        "latent_image": [
          "5",
          0
        ],
        "seed": "${SEED}",
        "steps": "${STEPS}",
        "cfg": "${CFG}",
        "sampler_name": "${SAMPLER}",
        "scheduler": "${SCHEDULER}",
        "denoise": 1.0
      }
    },
    "7": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "6",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "8": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "7",
          0
        ],
        "filename_prefix": "${FILENAME_PREFIX}"
      }
    }
  }
}
