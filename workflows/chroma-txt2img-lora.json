{
  "meta": {
    "id": "chroma-txt2img-lora",
    "title": "Chroma1-HD - Texto para Imagem com LoRA de persona",
    "description": "Igual ao chroma-txt2img, com uma LoRA aplicada ao modelo (LoraLoaderModelOnly) antes do sampler. Usado automaticamente quando a persona tem LoRA treinada (ex.: Luna, gatilho lunavox); o prompt precisa conter o gatilho.",
    "compatible_models": ["chroma1-hd-fp8"],
    "hidden": true,
    "required_params": ["PROMPT", "LORA_NAME"],
    "optional_params": {
      "NEGATIVE_PROMPT": "low quality, ugly, unfinished, out of focus, deformed, disfigured, blurry, smudged, restricted palette, flat colors, bad anatomy, extra fingers, watermark, signature, text",
      "WIDTH": 1024,
      "HEIGHT": 1024,
      "STEPS": 26,
      "GUIDANCE": 4.0,
      "SEED": 0,
      "SAMPLER_NAME": "euler",
      "FILENAME_PREFIX": "luna_studio",
      "LORA_STRENGTH": 1.0
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "${UNET_NAME}",
        "weight_dtype": "${UNET_WEIGHT_DTYPE}"
      }
    },
    "16": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": ["1", 0],
        "lora_name": "${LORA_NAME}",
        "strength_model": "${LORA_STRENGTH}"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "${CLIP_NAME_1}",
        "type": "${CLIP_TYPE}",
        "device": "default"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "${VAE_NAME}"
      }
    },
    "4": {
      "class_type": "T5TokenizerOptions",
      "inputs": {
        "clip": ["2", 0],
        "min_padding": 0,
        "min_length": 0
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "${PROMPT}",
        "clip": ["4", 0]
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "${NEGATIVE_PROMPT}",
        "clip": ["4", 0]
      }
    },
    "7": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": ["16", 0],
        "shift": 1.0
      }
    },
    "8": {
      "class_type": "CFGGuider",
      "inputs": {
        "model": ["7", 0],
        "positive": ["5", 0],
        "negative": ["6", 0],
        "cfg": "${GUIDANCE}"
      }
    },
    "9": {
      "class_type": "EmptySD3LatentImage",
      "inputs": {
        "width": "${WIDTH}",
        "height": "${HEIGHT}",
        "batch_size": 1
      }
    },
    "10": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "${SEED}"
      }
    },
    "11": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "${SAMPLER_NAME}"
      }
    },
    "12": {
      "class_type": "BetaSamplingScheduler",
      "inputs": {
        "model": ["7", 0],
        "steps": "${STEPS}",
        "alpha": 0.45,
        "beta": 0.45
      }
    },
    "13": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": ["10", 0],
        "guider": ["8", 0],
        "sampler": ["11", 0],
        "sigmas": ["12", 0],
        "latent_image": ["9", 0]
      }
    },
    "14": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["13", 0],
        "vae": ["3", 0]
      }
    },
    "15": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["14", 0],
        "filename_prefix": "${FILENAME_PREFIX}"
      }
    }
  }
}
