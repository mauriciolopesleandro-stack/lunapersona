{
  "meta": {
    "id": "realvis-face-pass-instantid",
    "title": "V2 - RealVisXL: passada de rosto com InstantID (identidade da master_face)",
    "hidden": true,
    "compatible_models": [],
    "description": "Persona Engine V2 (experimental): a passada de rosto com o InstantID. Identidade da master_face (REFERENCE), pontos do rosto do PROPRIO recorte (image_kps: a cabeca nao muda de direcao), checkpoint + LoRA da persona, denoise da passada; colado de volta com a mascara do backend. Modelos InstantX/InstantID no disco temporario do pod.",
    "required_params": [
      "IMAGE",
      "MASK",
      "PROMPT",
      "NEGATIVE",
      "SEED",
      "DENOISE",
      "LORA_NAME",
      "CROP_X",
      "CROP_Y",
      "CROP_W",
      "CROP_H",
      "WORK_W",
      "WORK_H",
      "REFERENCE"
    ],
    "optional_params": {
      "CKPT": "RealVisXL_V5.0_fp16.safetensors",
      "LORA_STRENGTH": 1.0,
      "STEPS": 20,
      "CFG": 5.0,
      "SAMPLER": "dpmpp_2m_sde",
      "SCHEDULER": "karras",
      "FILENAME_PREFIX": "luna_v2_face_iid",
      "INSTANTID": "instantid_ip-adapter.bin",
      "INSTANTID_CONTROLNET": "instantid_controlnet.safetensors",
      "ID_WEIGHT": 0.8
    }
  },
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "${CKPT}"
      }
    },
    "2": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "lora_name": "${LORA_NAME}",
        "strength_model": "${LORA_STRENGTH}"
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "1",
          1
        ],
        "text": "${PROMPT}"
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "1",
          1
        ],
        "text": "${NEGATIVE}"
      }
    },
    "10": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "${IMAGE}"
      }
    },
    "11": {
      "class_type": "ImageCrop",
      "inputs": {
        "image": [
          "10",
          0
        ],
        "width": "${CROP_W}",
        "height": "${CROP_H}",
        "x": "${CROP_X}",
        "y": "${CROP_Y}"
      }
    },
    "12": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "11",
          0
        ],
        "upscale_method": "lanczos",
        "width": "${WORK_W}",
        "height": "${WORK_H}",
        "crop": "disabled"
      }
    },
    "13": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "12",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "14": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "20",
          0
        ],
        "positive": [
          "20",
          1
        ],
        "negative": [
          "20",
          2
        ],
        "latent_image": [
          "13",
          0
        ],
        "seed": "${SEED}",
        "steps": "${STEPS}",
        "cfg": "${CFG}",
        "sampler_name": "${SAMPLER}",
        "scheduler": "${SCHEDULER}",
        "denoise": "${DENOISE}"
      }
    },
    "15": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "14",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "16": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "15",
          0
        ],
        "upscale_method": "lanczos",
        "width": "${CROP_W}",
        "height": "${CROP_H}",
        "crop": "disabled"
      }
    },
    "17": {
      "class_type": "LoadImageMask",
      "inputs": {
        "image": "${MASK}",
        "channel": "red"
      }
    },
    "18": {
      "class_type": "ImageCompositeMasked",
      "inputs": {
        "destination": [
          "10",
          0
        ],
        "source": [
          "16",
          0
        ],
        "x": "${CROP_X}",
        "y": "${CROP_Y}",
        "resize_source": false,
        "mask": [
          "17",
          0
        ]
      }
    },
    "19": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "18",
          0
        ],
        "filename_prefix": "${FILENAME_PREFIX}"
      }
    },
    "5": {
      "class_type": "InstantIDModelLoader",
      "inputs": {
        "instantid_file": "${INSTANTID}"
      }
    },
    "6": {
      "class_type": "InstantIDFaceAnalysis",
      "inputs": {
        "provider": "CPU"
      }
    },
    "7": {
      "class_type": "ControlNetLoader",
      "inputs": {
        "control_net_name": "${INSTANTID_CONTROLNET}"
      }
    },
    "8": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "${REFERENCE}"
      }
    },
    "20": {
      "class_type": "ApplyInstantID",
      "inputs": {
        "instantid": [
          "5",
          0
        ],
        "insightface": [
          "6",
          0
        ],
        "control_net": [
          "7",
          0
        ],
        "image": [
          "8",
          0
        ],
        "model": [
          "2",
          0
        ],
        "positive": [
          "3",
          0
        ],
        "negative": [
          "4",
          0
        ],
        "weight": "${ID_WEIGHT}",
        "start_at": 0.0,
        "end_at": 1.0,
        "image_kps": [
          "12",
          0
        ]
      }
    }
  }
}
