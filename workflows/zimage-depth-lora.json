{
  "meta": {
    "id": "zimage-depth-lora",
    "title": "Z-Image + LoRA + ControlNet de profundidade - reinterpretar uma foto com a persona",
    "description": "Reinterpretar a cena com a persona: a foto do zero com a LoRA dela (rosto e corpo), seguindo a profundidade da foto de referencia (Depth Anything V2 small) pelo ControlNet Union 2.1 lite do Z-Image. CONTROL_STRENGTH alto = mais parecido com a foto (o \"Quanto mudar\" do site vira 0.85-0.45). Partir da propria foto (img2img) nao trocava a pessoa: no Turbo a pessoa da foto ficava (teste de 2026-10-05).",
    "compatible_models": [
      "chroma1-hd-fp8"
    ],
    "hidden": true,
    "required_params": [
      "PROMPT",
      "REFERENCE_IMAGE",
      "WIDTH",
      "HEIGHT",
      "SEED",
      "LORA_NAME"
    ],
    "optional_params": {
      "STEPS": 8,
      "CFG": 1,
      "SHIFT": 3,
      "SAMPLER": "res_multistep",
      "SCHEDULER": "simple",
      "UNET": "z_image_turbo_int8_convrot.safetensors",
      "TEXT_ENCODER": "qwen_3_4b_fp4_mixed.safetensors",
      "VAE": "ae.safetensors",
      "FILENAME_PREFIX": "luna_fast",
      "LORA_STRENGTH": 1,
      "CONTROL_PATCH": "Z-Image-Turbo-Fun-Controlnet-Union-2.1-lite-2602-8steps.safetensors",
      "CONTROL_STRENGTH": 0.6,
      "DEPTH_MODEL": "depth_anything_v2_vits.pth"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "${UNET}",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "${TEXT_ENCODER}",
        "type": "lumina2",
        "device": "default"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "${VAE}"
      }
    },
    "4": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": [
          "30",
          0
        ],
        "shift": "${SHIFT}"
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "text": "${PROMPT}"
      }
    },
    "6": {
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": [
          "5",
          0
        ]
      }
    },
    "7": {
      "class_type": "EmptySD3LatentImage",
      "inputs": {
        "width": "${WIDTH}",
        "height": "${HEIGHT}",
        "batch_size": 1
      }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "4",
          0
        ],
        "positive": [
          "5",
          0
        ],
        "negative": [
          "6",
          0
        ],
        "latent_image": [
          "7",
          0
        ],
        "seed": "${SEED}",
        "steps": "${STEPS}",
        "cfg": "${CFG}",
        "sampler_name": "${SAMPLER}",
        "scheduler": "${SCHEDULER}",
        "denoise": 1
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "8",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "10": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "9",
          0
        ],
        "filename_prefix": "${FILENAME_PREFIX}"
      }
    },
    "11": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "lora_name": "${LORA_NAME}",
        "strength_model": "${LORA_STRENGTH}"
      }
    },
    "20": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "${REFERENCE_IMAGE}"
      }
    },
    "21": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "20",
          0
        ],
        "upscale_method": "lanczos",
        "width": "${WIDTH}",
        "height": "${HEIGHT}",
        "crop": "center"
      }
    },
    "22": {
      "class_type": "DepthAnythingV2Preprocessor",
      "inputs": {
        "image": [
          "21",
          0
        ],
        "ckpt_name": "${DEPTH_MODEL}",
        "resolution": 1024
      }
    },
    "23": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "22",
          0
        ],
        "upscale_method": "bilinear",
        "width": "${WIDTH}",
        "height": "${HEIGHT}",
        "crop": "disabled"
      }
    },
    "30": {
      "class_type": "ZImageFunControlnet",
      "inputs": {
        "model": [
          "11",
          0
        ],
        "model_patch": [
          "50",
          0
        ],
        "vae": [
          "3",
          0
        ],
        "strength": "${CONTROL_STRENGTH}",
        "image": [
          "23",
          0
        ]
      }
    },
    "50": {
      "class_type": "ModelPatchLoader",
      "inputs": {
        "name": "${CONTROL_PATCH}"
      }
    }
  }
}
