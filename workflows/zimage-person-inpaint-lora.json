{
  "meta": {
    "id": "zimage-person-inpaint-lora",
    "title": "Z-Image + LoRA + ControlNet - trocar a pessoa inteira mantendo a cena",
    "description": "Troca a pessoa da foto pela persona inteira (rosto E corpo pela LoRA), na mesma pose, mantendo o fundo exato. A pose vem do DWPose da propria foto e entra pelo ControlNet Union 2.1 lite do Z-Image (alibaba-pai, Apache 2.0) em modo inpaint: so a regiao da pessoa (SAM2 com POINTS_POS, alargada em MASK_GROW para caber o cabelo da persona) e redesenhada; o resto e colado de volta da foto original com borda suave (EDGE_BLUR). A troca so de cabeca (qwen-bfs-head-swap) mantinha o corpo e a pele da pessoa da foto. Forca do controle 0.65-0.80 (README do modelo). Modelos: scripts/setup_fast.sh + o ControlNet em models/model_patches. Pontos negativos (o rosto de outra pessoa) entram pelo backend direto no grafo renderizado - com a lista vazia o SAM2 quebrava.",
    "compatible_models": [
      "chroma1-hd-fp8"
    ],
    "hidden": true,
    "required_params": [
      "PROMPT",
      "REFERENCE_IMAGE",
      "WIDTH",
      "HEIGHT",
      "SEED",
      "LORA_NAME",
      "POINTS_POS"
    ],
    "optional_params": {
      "LORA_STRENGTH": 1,
      "CONTROL_PATCH": "Z-Image-Turbo-Fun-Controlnet-Union-2.1-lite-2602-8steps.safetensors",
      "CONTROL_STRENGTH": 0.75,
      "MASK_GROW": 24,
      "EDGE_BLUR": 12,
      "STEPS": 8,
      "CFG": 1,
      "SHIFT": 3,
      "SAMPLER": "res_multistep",
      "SCHEDULER": "simple",
      "UNET": "z_image_turbo_int8_convrot.safetensors",
      "TEXT_ENCODER": "qwen_3_4b_fp4_mixed.safetensors",
      "VAE": "ae.safetensors",
      "FILENAME_PREFIX": "luna_studio"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "${UNET}",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "${TEXT_ENCODER}",
        "type": "lumina2",
        "device": "default"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "${VAE}"
      }
    },
    "4": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": [
          "30",
          0
        ],
        "shift": "${SHIFT}"
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "text": "${PROMPT}"
      }
    },
    "6": {
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": [
          "5",
          0
        ]
      }
    },
    "7": {
      "class_type": "EmptySD3LatentImage",
      "inputs": {
        "width": "${WIDTH}",
        "height": "${HEIGHT}",
        "batch_size": 1
      }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "4",
          0
        ],
        "positive": [
          "5",
          0
        ],
        "negative": [
          "6",
          0
        ],
        "latent_image": [
          "7",
          0
        ],
        "seed": "${SEED}",
        "steps": "${STEPS}",
        "cfg": "${CFG}",
        "sampler_name": "${SAMPLER}",
        "scheduler": "${SCHEDULER}",
        "denoise": 1
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "8",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "10": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "${REFERENCE_IMAGE}"
      }
    },
    "11": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "lora_name": "${LORA_NAME}",
        "strength_model": "${LORA_STRENGTH}"
      }
    },
    "12": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "10",
          0
        ],
        "upscale_method": "lanczos",
        "width": "${WIDTH}",
        "height": "${HEIGHT}",
        "crop": "disabled"
      }
    },
    "20": {
      "class_type": "DWPreprocessor",
      "inputs": {
        "image": [
          "12",
          0
        ],
        "detect_hand": "enable",
        "detect_body": "enable",
        "detect_face": "enable",
        "resolution": 1024,
        "bbox_detector": "yolox_l.onnx",
        "pose_estimator": "dw-ll_ucoco_384_bs5.torchscript.pt",
        "scale_stick_for_xinsr_cn": "disable"
      }
    },
    "21": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "20",
          0
        ],
        "upscale_method": "bilinear",
        "width": "${WIDTH}",
        "height": "${HEIGHT}",
        "crop": "disabled"
      }
    },
    "24": {
      "class_type": "DownloadAndLoadSAM2Model",
      "inputs": {
        "model": "sam2_hiera_base_plus.safetensors",
        "segmentor": "single_image",
        "device": "cuda",
        "precision": "fp16"
      }
    },
    "25": {
      "class_type": "Sam2Segmentation",
      "inputs": {
        "sam2_model": [
          "24",
          0
        ],
        "image": [
          "12",
          0
        ],
        "keep_model_loaded": false,
        "coordinates_positive": "${POINTS_POS}",
        "individual_objects": false
      }
    },
    "26": {
      "class_type": "GrowMask",
      "inputs": {
        "mask": [
          "25",
          0
        ],
        "expand": "${MASK_GROW}",
        "tapered_corners": true
      }
    },
    "27": {
      "class_type": "GrowMaskWithBlur",
      "inputs": {
        "mask": [
          "26",
          0
        ],
        "expand": 0,
        "incremental_expandrate": 0,
        "tapered_corners": true,
        "flip_input": false,
        "blur_radius": "${EDGE_BLUR}",
        "lerp_alpha": 1,
        "decay_factor": 1
      }
    },
    "30": {
      "class_type": "ZImageFunControlnet",
      "inputs": {
        "model": [
          "11",
          0
        ],
        "model_patch": [
          "50",
          0
        ],
        "vae": [
          "3",
          0
        ],
        "strength": "${CONTROL_STRENGTH}",
        "image": [
          "21",
          0
        ],
        "inpaint_image": [
          "12",
          0
        ],
        "mask": [
          "26",
          0
        ]
      }
    },
    "40": {
      "class_type": "ImageCompositeMasked",
      "inputs": {
        "destination": [
          "12",
          0
        ],
        "source": [
          "9",
          0
        ],
        "x": 0,
        "y": 0,
        "resize_source": false,
        "mask": [
          "27",
          0
        ]
      }
    },
    "41": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "40",
          0
        ],
        "filename_prefix": "${FILENAME_PREFIX}"
      }
    },
    "50": {
      "class_type": "ModelPatchLoader",
      "inputs": {
        "name": "${CONTROL_PATCH}"
      }
    }
  }
}
