{
  "meta": {
    "id": "chroma-person-swap-lora",
    "title": "Chroma1-HD - Trocar a pessoa da foto pela persona (so a pessoa)",
    "description": "Pack com a persona: na foto enviada (REFERENCE_IMAGE, no tamanho WIDTH x HEIGHT - o original, ate ~2,4 MP) o Florence-2 acha a pessoa (TARGET) e o SAM2 recorta o contorno. So um recorte em volta dela, ampliado para CROP_RES no lado maior, e redesenhado com a LoRA (DENOISE 0.75: troca rosto, cabelo e corpo e mantem pose - 0.9 fazia a persona voltar a posar; 0.65 deixava o cabelo original voltar). As maos (Florence 'hands' no recorte) sao redesenhadas so de leve (DifferentialDiffusion, mascara HANDS_STRENGTH): gesto e objetos ficam iguais. O recorte volta para a foto original com a borda suave (ImageUncropByMask): o cenario nao e tocado e fica nitido. Antes a foto inteira era reduzida para ~1 MP e tudo saia borrado. Depois passa a correcao de rosto.",
    "compatible_models": [
      "chroma1-hd-fp8"
    ],
    "hidden": true,
    "required_params": [
      "PROMPT",
      "REFERENCE_IMAGE",
      "LORA_NAME"
    ],
    "optional_params": {
      "NEGATIVE_PROMPT": "low quality, ugly, deformed, disfigured, blurry, bad anatomy, extra fingers, extra legs, extra limbs, extra arms, extra hands, missing limbs, fused limbs, malformed limbs, watermark, signature, text, logo, letters, airbrushed, plastic skin, waxy skin, overly smooth skin, cgi, 3d render, illustration, cartoon, doll, oversaturated, beauty filter, two women, duplicate person",
      "WIDTH": 1024,
      "HEIGHT": 1024,
      "STEPS": 28,
      "GUIDANCE": 3,
      "SEED": 0,
      "SAMPLER_NAME": "euler",
      "FILENAME_PREFIX": "luna_studio",
      "LORA_STRENGTH": 1,
      "DENOISE": 0.75,
      "TARGET": "woman",
      "MASK_GROW": 24,
      "HANDS_STRENGTH": 0.45,
      "CROP_RES": 1344,
      "CROP_PADDING": 48
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "${UNET_NAME}",
        "weight_dtype": "${UNET_WEIGHT_DTYPE}"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "${CLIP_NAME_1}",
        "type": "${CLIP_TYPE}",
        "device": "default"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "${VAE_NAME}"
      }
    },
    "4": {
      "class_type": "T5TokenizerOptions",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "min_padding": 0,
        "min_length": 0
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "${PROMPT}",
        "clip": [
          "4",
          0
        ]
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "${NEGATIVE_PROMPT}",
        "clip": [
          "4",
          0
        ]
      }
    },
    "7": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": [
          "16",
          0
        ],
        "shift": 1
      }
    },
    "8": {
      "class_type": "CFGGuider",
      "inputs": {
        "model": [
          "9",
          0
        ],
        "positive": [
          "5",
          0
        ],
        "negative": [
          "6",
          0
        ],
        "cfg": "${GUIDANCE}"
      }
    },
    "9": {
      "class_type": "DifferentialDiffusion",
      "inputs": {
        "model": [
          "7",
          0
        ]
      }
    },
    "10": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "${SEED}"
      }
    },
    "11": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "${SAMPLER_NAME}"
      }
    },
    "12": {
      "class_type": "BetaSamplingScheduler",
      "inputs": {
        "model": [
          "7",
          0
        ],
        "steps": "${STEPS}",
        "alpha": 0.45,
        "beta": 0.45
      }
    },
    "13": {
      "class_type": "SplitSigmasDenoise",
      "inputs": {
        "sigmas": [
          "12",
          0
        ],
        "denoise": "${DENOISE}"
      }
    },
    "15": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "32",
          0
        ],
        "filename_prefix": "${FILENAME_PREFIX}"
      }
    },
    "16": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "lora_name": "${LORA_NAME}",
        "strength_model": "${LORA_STRENGTH}"
      }
    },
    "19": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "20",
          0
        ],
        "upscale_method": "lanczos",
        "width": "${WIDTH}",
        "height": "${HEIGHT}",
        "crop": "disabled"
      }
    },
    "20": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "${REFERENCE_IMAGE}"
      }
    },
    "21": {
      "class_type": "DownloadAndLoadFlorence2Model",
      "inputs": {
        "model": "microsoft/Florence-2-large",
        "precision": "fp16"
      }
    },
    "22": {
      "class_type": "Florence2Run",
      "inputs": {
        "image": [
          "19",
          0
        ],
        "florence2_model": [
          "21",
          0
        ],
        "text_input": "${TARGET}",
        "task": "caption_to_phrase_grounding",
        "fill_mask": false,
        "keep_model_loaded": false,
        "max_new_tokens": 256,
        "num_beams": 3,
        "do_sample": false,
        "output_mask_select": "",
        "seed": 1
      }
    },
    "23": {
      "class_type": "Florence2toCoordinates",
      "inputs": {
        "data": [
          "22",
          3
        ],
        "index": "0",
        "batch": false
      }
    },
    "24": {
      "class_type": "DownloadAndLoadSAM2Model",
      "inputs": {
        "model": "sam2_hiera_base_plus.safetensors",
        "segmentor": "single_image",
        "device": "cuda",
        "precision": "fp16"
      }
    },
    "25": {
      "class_type": "Sam2Segmentation",
      "inputs": {
        "sam2_model": [
          "24",
          0
        ],
        "image": [
          "19",
          0
        ],
        "keep_model_loaded": false,
        "bboxes": [
          "23",
          1
        ],
        "individual_objects": false
      }
    },
    "26": {
      "class_type": "GrowMask",
      "inputs": {
        "mask": [
          "25",
          0
        ],
        "expand": "${MASK_GROW}",
        "tapered_corners": true
      }
    },
    "27": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "50",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "28": {
      "class_type": "SetLatentNoiseMask",
      "inputs": {
        "samples": [
          "27",
          0
        ],
        "mask": [
          "44",
          0
        ]
      }
    },
    "29": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "10",
          0
        ],
        "guider": [
          "8",
          0
        ],
        "sampler": [
          "11",
          0
        ],
        "sigmas": [
          "13",
          1
        ],
        "latent_image": [
          "28",
          0
        ]
      }
    },
    "30": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "29",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "31": {
      "class_type": "ImageCompositeMasked",
      "inputs": {
        "destination": [
          "50",
          0
        ],
        "source": [
          "30",
          0
        ],
        "x": 0,
        "y": 0,
        "resize_source": false,
        "mask": [
          "50",
          1
        ]
      }
    },
    "32": {
      "class_type": "ImageUncropByMask",
      "inputs": {
        "destination": [
          "19",
          0
        ],
        "source": [
          "31",
          0
        ],
        "mask": [
          "50",
          1
        ],
        "bbox": [
          "50",
          2
        ]
      }
    },
    "40": {
      "class_type": "Florence2Run",
      "inputs": {
        "image": [
          "50",
          0
        ],
        "florence2_model": [
          "21",
          0
        ],
        "text_input": "hands",
        "task": "caption_to_phrase_grounding",
        "fill_mask": true,
        "keep_model_loaded": false,
        "max_new_tokens": 256,
        "num_beams": 3,
        "do_sample": false,
        "output_mask_select": "",
        "seed": 1
      }
    },
    "41": {
      "class_type": "GrowMask",
      "inputs": {
        "mask": [
          "40",
          1
        ],
        "expand": 8,
        "tapered_corners": true
      }
    },
    "42": {
      "class_type": "SolidMask",
      "inputs": {
        "value": 1,
        "width": [
          "53",
          0
        ],
        "height": [
          "53",
          1
        ]
      }
    },
    "43": {
      "class_type": "MaskComposite",
      "inputs": {
        "destination": [
          "41",
          0
        ],
        "source": [
          "46",
          0
        ],
        "x": 0,
        "y": 0,
        "operation": "multiply"
      }
    },
    "44": {
      "class_type": "MaskComposite",
      "inputs": {
        "destination": [
          "50",
          1
        ],
        "source": [
          "43",
          0
        ],
        "x": 0,
        "y": 0,
        "operation": "subtract"
      }
    },
    "45": {
      "class_type": "SolidMask",
      "inputs": {
        "value": "${HANDS_STRENGTH}",
        "width": [
          "53",
          0
        ],
        "height": [
          "53",
          1
        ]
      }
    },
    "46": {
      "class_type": "MaskComposite",
      "inputs": {
        "destination": [
          "42",
          0
        ],
        "source": [
          "45",
          0
        ],
        "x": 0,
        "y": 0,
        "operation": "subtract"
      }
    },
    "50": {
      "class_type": "ImageCropByMaskAndResize",
      "inputs": {
        "image": [
          "19",
          0
        ],
        "mask": [
