{
  "meta": {
    "id": "zimage-txt2img",
    "title": "Z-Image Turbo - texto para imagem (rapido e realista)",
    "description": "Z-Image Turbo 6B (Tongyi/Alibaba, Apache 2.0), destilado para 8 passos: segundos por foto em vez dos minutos do Chroma (26 passos + hires + retoque). Grafo do template oficial da ComfyUI (image_z_image_turbo: CLIPLoader lumina2, ModelSamplingAuraFlow shift 3, KSampler 8 passos cfg 1 res_multistep/simple, negativo = ConditioningZeroOut). A identidade da persona nao vem daqui: a cena sai com uma mulher parecida e o rosto/cabelo dela entram depois pela troca de cabeca (qwen-bfs-head-swap). Modelos: scripts/setup_fast.sh.",
    "compatible_models": ["chroma1-hd-fp8"],
    "hidden": true,
    "required_params": ["PROMPT", "WIDTH", "HEIGHT", "SEED"],
    "optional_params": {
      "STEPS": 8,
      "CFG": 1.0,
      "SHIFT": 3.0,
      "SAMPLER": "res_multistep",
      "SCHEDULER": "simple",
      "UNET": "z_image_turbo_bf16.safetensors",
      "TEXT_ENCODER": "qwen_3_4b_fp8_mixed.safetensors",
      "VAE": "ae.safetensors",
      "FILENAME_PREFIX": "luna_fast"
    }
  },
  "graph": {
    "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "${UNET}", "weight_dtype": "default"}},
    "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "${TEXT_ENCODER}", "type": "lumina2", "device": "default"}},
    "3": {"class_type": "VAELoader", "inputs": {"vae_name": "${VAE}"}},
    "4": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["1", 0], "shift": "${SHIFT}"}},
    "5": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": "${PROMPT}"}},
    "6": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["5", 0]}},
    "7": {"class_type": "EmptySD3LatentImage", "inputs": {"width": "${WIDTH}", "height": "${HEIGHT}", "batch_size": 1}},
    "8": {"class_type": "KSampler", "inputs": {"model": ["4", 0], "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["7", 0], "seed": "${SEED}", "steps": "${STEPS}", "cfg": "${CFG}", "sampler_name": "${SAMPLER}", "scheduler": "${SCHEDULER}", "denoise": 1}},
    "9": {"class_type": "VAEDecode", "inputs": {"samples": ["8", 0], "vae": ["3", 0]}},
    "10": {"class_type": "SaveImage", "inputs": {"images": ["9", 0], "filename_prefix": "${FILENAME_PREFIX}"}}
  }
}
