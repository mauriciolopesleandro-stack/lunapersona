{
  "meta": {
    "id": "voice-clone",
    "title": "Qwen3-TTS - Falar com a voz da persona",
    "description": "Fala TEXT clonando a voz de REF_AUDIO (o audio de referencia da persona, ja no input/ do ComfyUI) cujo conteudo falado e REF_TEXT. Precisa de scripts/setup_voice.sh.",
    "compatible_models": [],
    "hidden": true,
    "required_params": ["TEXT", "REF_AUDIO", "REF_TEXT"],
    "optional_params": {
      "SEED": 0,
      "LANGUAGE": "Portuguese",
      "FILENAME_PREFIX": "voice/luna_fala"
    }
  },
  "graph": {
    "1": {
      "class_type": "LoadAudio",
      "inputs": {
        "audio": "${REF_AUDIO}"
      }
    },
    "2": {
      "class_type": "FB_Qwen3TTSVoiceClone",
      "inputs": {
        "target_text": "${TEXT}",
        "model_choice": "1.7B",
        "device": "cuda",
        "precision": "bf16",
        "language": "${LANGUAGE}",
        "ref_audio": ["1", 0],
        "ref_text": "${REF_TEXT}",
        "seed": "${SEED}",
        "unload_model_after_generate": true
      }
    },
    "3": {
      "class_type": "SaveAudioMP3",
      "inputs": {
        "audio": ["2", 0],
        "filename_prefix": "${FILENAME_PREFIX}",
        "quality": "320k"
      }
    }
  }
}
