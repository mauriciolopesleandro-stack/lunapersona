{
  "meta": {
    "id": "realvis-person-replace",
    "hidden": true,
    "compatible_models": [],
    "title": "V2 - Replicar foto: troca a pessoa pela persona e mantem a foto",
    "description": "Persona Engine V2, modo replicar foto. A pessoa escolhida (pontos do SAM2 vindos da leitura da foto) e recortada, ampliada e redesenhada com RealVisXL + LoRA da persona a partir dos proprios pixels (denoise moderado: pose, roupa e luz vem da foto); so a area da pessoa volta para a foto. Fora da mascara os pixels sao os originais (ambiente, luz e cor intactos, sem filtro). Salva tambem a mascara da pessoa (prefixo _mask) para as passadas e para conferir o fundo.",
    "required_params": [
      "REFERENCE",
      "PROMPT",
      "NEGATIVE",
      "SEED",
      "DENOISE",
      "LORA_NAME",
      "POINTS_POS",
      "POINTS_NEG",
      "CROP_X",
      "CROP_Y",
      "CROP_W",
      "CROP_H",
      "WORK_W",
      "WORK_H"
    ],
    "optional_params": {
      "CKPT": "RealVisXL_V5.0_fp16.safetensors",
      "LORA_STRENGTH": 1.0,
      "STEPS": 30,
      "CFG": 5.0,
      "SAMPLER": "dpmpp_2m_sde",
      "SCHEDULER": "karras",
      "SAM_MODEL": "sam2_hiera_base_plus.safetensors",
      "MASK_GROW": 16,
      "EDGE_BLUR": 10,
      "FILENAME_PREFIX": "luna_v2_replace"
    }
  },
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "${CKPT}"
      }
    },
    "2": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "lora_name": "${LORA_NAME}",
        "strength_model": "${LORA_STRENGTH}"
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "1",
          1
        ],
        "text": "${PROMPT}"
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "1",
          1
        ],
        "text": "${NEGATIVE}"
      }
    },
    "10": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "${REFERENCE}"
      }
    },
    "24": {
      "class_type": "DownloadAndLoadSAM2Model",
      "inputs": {
        "model": "${SAM_MODEL}",
        "segmentor": "single_image",
        "device": "cuda",
        "precision": "fp16"
      }
    },
    "25": {
      "class_type": "Sam2Segmentation",
      "inputs": {
        "sam2_model": [
          "24",
          0
        ],
        "image": [
          "10",
          0
        ],
        "keep_model_loaded": false,
        "coordinates_positive": "${POINTS_POS}",
        "coordinates_negative": "${POINTS_NEG}",
        "individual_objects": false
      }
    },
    "26": {
      "class_type": "GrowMask",
      "inputs": {
        "mask": [
          "25",
          0
        ],
        "expand": "${MASK_GROW}",
        "tapered_corners": true
      }
    },
    "27": {
      "class_type": "GrowMaskWithBlur",
      "inputs": {
        "mask": [
          "26",
          0
        ],
        "expand": 0,
        "incremental_expandrate": 0,
        "tapered_corners": true,
        "flip_input": false,
        "blur_radius": "${EDGE_BLUR}",
        "lerp_alpha": 1,
        "decay_factor": 1
      }
    },
    "30": {
      "class_type": "ImageCrop",
      "inputs": {
        "image": [
          "10",
          0
        ],
        "width": "${CROP_W}",
        "height": "${CROP_H}",
        "x": "${CROP_X}",
        "y": "${CROP_Y}"
      }
    },
    "31": {
      "class_type": "CropMask",
      "inputs": {
        "mask": [
          "27",
          0
        ],
        "x": "${CROP_X}",
        "y": "${CROP_Y}",
        "width": "${CROP_W}",
        "height": "${CROP_H}"
      }
    },
    "32": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "30",
          0
        ],
        "upscale_method": "lanczos",
        "width": "${WORK_W}",
        "height": "${WORK_H}",
        "crop": "disabled"
      }
    },
    "33": {
      "class_type": "MaskToImage",
      "inputs": {
        "mask": [
          "31",
          0
        ]
      }
    },
    "34": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "33",
          0
        ],
        "upscale_method": "bilinear",
        "width": "${WORK_W}",
        "height": "${WORK_H}",
        "crop": "disabled"
      }
    },
    "35": {
      "class_type": "ImageToMask",
      "inputs": {
        "image": [
          "34",
          0
        ],
        "channel": "red"
      }
    },
    "36": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "32",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "37": {
      "class_type": "SetLatentNoiseMask",
      "inputs": {
        "samples": [
          "36",
          0
        ],
        "mask": [
          "35",
          0
        ]
      }
    },
    "38": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "positive": [
          "3",
          0
        ],
        "negative": [
          "4",
          0
        ],
        "latent_image": [
          "37",
          0
        ],
        "seed": "${SEED}",
        "steps": "${STEPS}",
        "cfg": "${CFG}",
        "sampler_name": "${SAMPLER}",
        "scheduler": "${SCHEDULER}",
        "denoise": "${DENOISE}"
      }
    },
    "39": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "38",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "40": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "39",
          0
        ],
        "upscale_method": "lanczos",
        "width": "${CROP_W}",
        "height": "${CROP_H}",
        "crop": "disabled"
      }
    },
    "41": {
      "class_type": "ImageCompositeMasked",
      "inputs": {
        "destination": [
          "10",
          0
        ],
        "source": [
          "40",
          0
        ],
        "x": "${CROP_X}",
        "y": "${CROP_Y}",
        "resize_source": false,
        "mask": [
          "31",
          0
        ]
      }
    },
    "42": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "41",
          0
        ],
        "filename_prefix": "${FILENAME_PREFIX}"
      }
    },
    "43": {
      "class_type": "MaskToImage",
      "inputs": {
        "mask": [
          "27",
          0
        ]
      }
    },
    "44": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "43",
          0
        ],
        "filename_prefix": "${FILENAME_PREFIX}_mask"
      }
    }
  }
}
