{
  "meta": {
    "id": "flux-kontext-reference",
    "title": "FLUX.1 Kontext - Geracao ancorada em imagem de referencia",
    "description": "Mesmo grafo do flux-kontext-txt2img, mas com a identidade ancorada numa foto de referencia real via FluxKontextImageScale + VAEEncode + ReferenceLatent (padrao oficial do template 'Image Edit - Flux.1 Kontext Dev' do ComfyUI). O tamanho da saida continua definido por WIDTH/HEIGHT (EmptyLatentImage), independente do tamanho/proporcao da imagem de referencia - so a identidade e herdada dela, nao o enquadramento. Usado automaticamente pelo GenerationService quando a persona tem pelo menos uma referencia cadastrada.",
    "compatible_models": ["flux-kontext-dev-fp8"],
    "required_params": ["PROMPT", "REFERENCE_IMAGE"],
    "optional_params": {
      "WIDTH": 1024,
      "HEIGHT": 1024,
      "STEPS": 20,
      "GUIDANCE": 2.5,
      "SEED": 0,
      "SAMPLER_NAME": "euler",
      "SCHEDULER": "simple",
      "FILENAME_PREFIX": "luna_studio"
    }
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "${UNET_NAME}",
        "weight_dtype": "${UNET_WEIGHT_DTYPE}"
      }
    },
    "2": {
      "class_type": "DualCLIPLoader",
      "inputs": {
        "clip_name1": "${CLIP_NAME_1}",
        "clip_name2": "${CLIP_NAME_2}",
        "type": "${CLIP_TYPE}"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "${VAE_NAME}"
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "${PROMPT}",
        "clip": ["2", 0]
      }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": "${WIDTH}",
        "height": "${HEIGHT}",
        "batch_size": 1
      }
    },
    "14": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "${REFERENCE_IMAGE}"
      }
    },
    "15": {
      "class_type": "FluxKontextImageScale",
      "inputs": {
        "image": ["14", 0]
      }
    },
    "16": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": ["15", 0],
        "vae": ["3", 0]
      }
    },
    "17": {
      "class_type": "ReferenceLatent",
      "inputs": {
        "conditioning": ["4", 0],
        "latent": ["16", 0]
      }
    },
    "6": {
      "class_type": "FluxGuidance",
      "inputs": {
        "conditioning": ["17", 0],
        "guidance": "${GUIDANCE}"
      }
    },
    "7": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "${SEED}"
      }
    },
    "8": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "${SAMPLER_NAME}"
      }
    },
    "9": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": ["1", 0],
        "scheduler": "${SCHEDULER}",
        "steps": "${STEPS}",
        "denoise": 1.0
      }
    },
    "10": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": ["1", 0],
        "conditioning": ["6", 0]
      }
    },
    "11": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": ["7", 0],
        "guider": ["10", 0],
        "sampler": ["8", 0],
        "sigmas": ["9", 0],
        "latent_image": ["5", 0]
      }
    },
    "12": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["11", 0],
        "vae": ["3", 0]
      }
    },
    "13": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["12", 0],
        "filename_prefix": "${FILENAME_PREFIX}"
      }
    }
  }
}
