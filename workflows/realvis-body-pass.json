{
  "meta": {
    "id": "realvis-body-pass",
    "title": "V2 - RealVisXL: passada de corpo (regiao)",
    "hidden": true,
    "compatible_models": [],
    "description": "Persona Engine V2 (experimental): passada numa regiao. Recorta a imagem anterior, amplia, redesenha com checkpoint + LoRA da persona (denoise da passada) e cola de volta com a mascara desenhada pelo backend (opacidade = strength). Fora da mascara a imagem fica identica.",
    "required_params": [
      "IMAGE",
      "MASK",
      "PROMPT",
      "NEGATIVE",
      "SEED",
      "DENOISE",
      "LORA_NAME",
      "CROP_X",
      "CROP_Y",
      "CROP_W",
      "CROP_H",
      "WORK_W",
      "WORK_H"
    ],
    "optional_params": {
      "CKPT": "RealVisXL_V5.0_fp16.safetensors",
      "LORA_STRENGTH": 1.0,
      "STEPS": 20,
      "CFG": 5.0,
      "SAMPLER": "dpmpp_2m_sde",
      "SCHEDULER": "karras",
      "FILENAME_PREFIX": "luna_v2_body"
    }
  },
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "${CKPT}"
      }
    },
    "2": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "lora_name": "${LORA_NAME}",
        "strength_model": "${LORA_STRENGTH}"
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "1",
          1
        ],
        "text": "${PROMPT}"
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "1",
          1
        ],
        "text": "${NEGATIVE}"
      }
    },
    "10": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "${IMAGE}"
      }
    },
    "11": {
      "class_type": "ImageCrop",
      "inputs": {
        "image": [
          "10",
          0
        ],
        "width": "${CROP_W}",
        "height": "${CROP_H}",
        "x": "${CROP_X}",
        "y": "${CROP_Y}"
      }
    },
    "12": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "11",
          0
        ],
        "upscale_method": "lanczos",
        "width": "${WORK_W}",
        "height": "${WORK_H}",
        "crop": "disabled"
      }
    },
    "13": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "12",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "14": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "positive": [
          "3",
          0
        ],
        "negative": [
          "4",
          0
        ],
        "latent_image": [
          "13",
          0
        ],
        "seed": "${SEED}",
        "steps": "${STEPS}",
        "cfg": "${CFG}",
        "sampler_name": "${SAMPLER}",
        "scheduler": "${SCHEDULER}",
        "denoise": "${DENOISE}"
      }
    },
    "15": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "14",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "16": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "15",
          0
        ],
        "upscale_method": "lanczos",
        "width": "${CROP_W}",
        "height": "${CROP_H}",
        "crop": "disabled"
      }
    },
    "17": {
      "class_type": "LoadImageMask",
      "inputs": {
        "image": "${MASK}",
        "channel": "red"
      }
    },
    "18": {
      "class_type": "ImageCompositeMasked",
      "inputs": {
        "destination": [
          "10",
          0
        ],
        "source": [
          "16",
          0
        ],
        "x": "${CROP_X}",
        "y": "${CROP_Y}",
        "resize_source": false,
        "mask": [
          "17",
          0
        ]
      }
    },
    "19": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "18",
          0
        ],
        "filename_prefix": "${FILENAME_PREFIX}"
      }
    }
  }
}
