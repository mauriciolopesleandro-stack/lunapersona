# --- Segredos e configuração local ---
.env
*.env.local
.secrets/

# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- Setup persistente do pod (fica no Network Volume, nunca no Git) ---
.venv-persist/
.venv-sync/
.ollama-models/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
npm-debug.log*

# --- Modelos e pesos (nunca versionar) ---
*.safetensors
*.ckpt
*.pt
*.bin
*.onnx

# --- Referências e mídia gerada (grandes, ficam fora do Git) ---
personas/*/references/*
personas/*/voice/*
